{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@velo/api/*": ["apps/api/src/*"],
      "@velo/mobile-rider/*": ["apps/mobile-rider/src/*"],
      "@velo/mobile-mechanic/*": ["apps/mobile-mechanic/src/*"],
      "@velo/shared": ["packages/shared/src"],
      "@velo/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "**/dist"]
}
